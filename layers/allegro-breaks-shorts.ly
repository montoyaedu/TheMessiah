% Interruzioni di sistema per l'edizione "shorts" (video verticale).
% Voce di soli spazi, parallela alla musica: s1*N = N battute.
allegroBreaks = {
  s1   \break   % 1
  s1*2 \break   % 2-3
  s1   \break   % 4
  s1*4 \break   % 5-8
  s1*3 \break   % 9-11
  s1*7          % 12-18 (automatiche)
}
