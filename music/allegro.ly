\version "2.24.0"
\language "italiano"

% Allegro moderato -- SOLO CONTENUTO MUSICALE.
% Qui vivono solo note e durate. Diteggiature, corde e barre' stanno in
% dita/; \break, colori, formato pagina e ritocchi in layers/ e editions/.
% Ogni battuta ha il suo numero (%N) e il controllo "|".

violinoA = \relative do' {
    \key mi \minor
    %1
    r4                 si'                sol               fad8    mi   |
    %2
    fad4           si,              fad'             
    \grace sold32 \trill (\grace la sold4) |
    %3
    la4                 mi                 la2~                                   |
    %4
    la8      si        sol      la       fad      si     la      si     |
    %5
    sol4           
    mi               
    si'2~                                |
    %6
    si4                la8        sol       la4                 sol8      fad      |
    %7
    sol2~                                   sol8       fad      sol       mi       |
    %8
    fad4               si~                  si                  lad                |
    %9
    si8      si,       dod        red       mi2~                                   |
    %10
    mi4                re8        dod       re4                 dod8      si       |
    %11
    do4.                          si8       
    \once \override NoteColumn.force-hshift = #1
    la         sol      fad       mi       |
}

violinoB = \relative do' {
    \key mi \minor
    %1
    s1                                                                             |
    %2
    s1                                                                             |
    %3
    s1                                                                             |
    %4
    s1                                                                             |
    %5
    r4                 
    \once \override NoteColumn.force-hshift = #1
    mi4              
    re                dod8    si       |
    %6
    dod4               fad,                 do'                 red                |
    %7
    mi                 si                   mi2~                                   |
    %8
    mi8      fad       re         mi        dod        fad      mi        fad      |
    %9
    red4               fad,                 si                  la8       sol      |
    %10
    la4                fad4~                fad                 mi                 |
    %11
    \stemUp
    \once \override NoteColumn.force-hshift = #-1
    mi                 sold                 la8
    \once \override NoteColumn.force-hshift = #1
    si       
    \once \override NoteColumn.force-hshift = #1
    do4                |
}

bassi = \relative do {
    \key mi \minor
    %1
    s1                                                                             |
    %2
    s1                                                                             |
    %3
    s1                                                                             |
    %4
    s1                                                                             |
    %5
    s1                                                                             |
    %6
    s1                                                                             |
    %7
    s1                                                                             |
    %8
    s1                                                                             |
    %9
    s4                si                     sol                fad8       mi      |
    %10
    fad4              si                     fad                sold               |
    %11
    la                mi                     la2~                                  |
}

viola = \relative do {
    \key mi \minor
    %1
    s1                                                                             |
    %2
    s1                                                                             |
    %3
    s1                                                                             |
    %4
    s1                                                                             |
    %5
    s1                                                                             |
    %6
    s1                                                                             |
    %7
    s1                                                                             |
    %8
    s1                                                                             |
    %9
    s1                                                                             |
    %10
    s1                                                                             |
    %11
    mi4.                          re8         
    \once \override NoteColumn.force-hshift = #1
    do
    si       la4              |
}
